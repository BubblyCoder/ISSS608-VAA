      <aliases enabled='yes' />
      <column caption='UCL' datatype='real' name='[Calculation_2217452125450240]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales])) + WINDOW_STDEV(SUM([Sales])) * [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Out of Control Limit' datatype='real' name='[Calculation_2217452129771523]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) &gt; [Calculation_2217452125450240]&#13;&#10;OR SUM([Sales]) &lt; [UCL (copy)_2217452126867458]&#13;&#10;THEN SUM([Sales])&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Gain or Lost' datatype='string' name='[Calculation_2217452144914436]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [Sub-Category] : SUM(IF DATEPART(&apos;year&apos;,[Order Date]) = 2025 THEN [Sales] END)} &gt;&#13;&#10;{FIXED [Sub-Category]: SUM(IF DATEPART(&apos;year&apos;,[Order Date])= 2022 THEN [Sales] END)}&#13;&#10;THEN &quot;Gain&quot; ELSE &quot;Loss&quot; END' />
      </column>
      <column caption='Loss Variables' datatype='string' name='[Calculation_2217452148277253]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Sub-Category] = &quot;Envelope&quot; OR [Sub-Category] = &quot;Machine&quot; THEN [Sub-Category] END' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country/Region]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='date' name='[Order Date]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='nominal' />
      <column datatype='integer' name='[Row ID]' role='dimension' type='ordinal' />
      <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
      <column datatype='string' name='[State/Province]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
      <column caption='LCL' datatype='real' name='[UCL (copy)_2217452126867458]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales])) - WINDOW_STDEV(SUM([Sales])) * [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
